# apps/api/.env.example — copy to .env for local development.

# HTTP
PORT=8080
ENV=development

# Database. Local: `docker compose up -d db` at the repo root.
# Production (Neon): DATABASE_URL = the POOLED string (host contains "-pooler"),
# MIGRATIONS_DATABASE_URL = the DIRECT string; both with sslmode=require.
DATABASE_URL=postgres://qdjr:qdjr@127.0.0.1:5432/qdjr?sslmode=disable
# MIGRATIONS_DATABASE_URL=
# Apply embedded goose migrations before serving. true on Render; locally use `go run ./cmd/migrate`.
RUN_MIGRATIONS=false

# Auth: own HS256 JWTs. At least 32 bytes; generate with `openssl rand -hex 32`.
JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h

# First super_admin, created at start if this email has no account yet.
BOOTSTRAP_ADMIN_EMAIL=admin@qdjr.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow123!

# Media. Leave R2_* empty locally: files go to MEDIA_DIR and are served at
# http://localhost:$PORT/media-files. Production requires all four R2_* values
# and MEDIA_PUBLIC_BASE_URL (bucket r2.dev URL or a custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# MEDIA_PUBLIC_BASE_URL=
# MEDIA_DIR=tmp/media

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
